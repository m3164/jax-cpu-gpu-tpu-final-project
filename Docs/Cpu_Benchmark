### Exercise 11: Cluster Profiling & Performance Delta Log
> Cycle the compiled kernel across CPU, GPU, and TPU nodes and log execution latency.

```python
cluster_backends = ['cpu', 'gpu', 'tpu']
benchmark_metrics = {}

for backend in cluster_backends:
    try:
        X_tr_jax, X_te_jax = allocate_workload_to_hardware(
            X_train.to_numpy(), X_test.to_numpy(), backend_target=backend
        )

        # Warm-up cycle to decouple XLA compile overhead from throughput timing
        _ = compute_cluster_pairwise_distances(X_tr_jax, X_te_jax).block_until_ready()

        # Timed execution
        start_mark = time.perf_counter()
        distances = compute_cluster_pairwise_distances(X_tr_jax, X_te_jax).block_until_ready()
        end_mark = time.perf_counter()

        elapsed_time_ms = (end_mark - start_mark) * 1000
        benchmark_metrics[backend] = f"{elapsed_time_ms:.4f} ms"

    except (RuntimeError, ValueError) as e:
        benchmark_metrics[backend] = "Target hardware cluster pool unconfigured or busy"

print("\n=== Cluster Performance Delta Report ===")
for device_type, execution_speed in benchmark_metrics.items():
    print(f"Hardware Layer: {device_type.upper():<4} | Kernel Compute Latency: {execution_speed}")
```
### Exercise 11 (extended): Statistical Benchmark Function

```python
def benchmark_backend(
    X_train,
    X_test,
    backend,
    warmup_runs=10,
    measured_runs=100
):
    X_tr_jax, X_te_jax = allocate_workload_to_hardware(
        X_train,
        X_test,
        backend_target=backend
    )

    # Multiple warm-ups: compilation, initialization and cache stabilization
    for _ in range(warmup_runs):
        compute_cluster_pairwise_distances(
            X_tr_jax,
            X_te_jax
        ).block_until_ready()

    timings_ms = []

    for _ in range(measured_runs):
        start = time.perf_counter_ns()

        compute_cluster_pairwise_distances(
            X_tr_jax,
            X_te_jax
        ).block_until_ready()

        end = time.perf_counter_ns()
        timings_ms.append((end - start) / 1_000_000)

    timings_ms = np.asarray(timings_ms)

    return {
        "median_ms": float(np.median(timings_ms)),
        "mean_ms": float(np.mean(timings_ms)),
        "min_ms": float(np.min(timings_ms)),
        "p25_ms": float(np.percentile(timings_ms, 25)),
        "p75_ms": float(np.percentile(timings_ms, 75)),
        "std_ms": float(np.std(timings_ms)),
        "all_timings_ms": timings_ms.tolist()
    }
```


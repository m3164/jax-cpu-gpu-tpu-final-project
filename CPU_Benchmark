      "source": [
        "def benchmark_backend(\n",
        "    X_train,\n",
        "    X_test,\n",
        "    backend,\n",
        "    warmup_runs=10,\n",
        "    measured_runs=100\n",
        "):\n",
        "    X_tr_jax, X_te_jax = allocate_workload_to_hardware(\n",
        "        X_train,\n",
        "        X_test,\n",
        "        backend_target=backend\n",
        "    )\n",
        "\n",
        "    # Multiple warm-ups: compilation, initialization and cache stabilization\n",
        "    for _ in range(warmup_runs):\n",
        "        compute_cluster_pairwise_distances(\n",
        "            X_tr_jax,\n",
        "            X_te_jax\n",
        "        ).block_until_ready()\n",
        "\n",
        "    timings_ms = []\n",
        "\n",
        "    for _ in range(measured_runs):\n",
        "        start = time.perf_counter_ns()\n",
        "\n",
        "        compute_cluster_pairwise_distances(\n",
        "            X_tr_jax,\n",
        "            X_te_jax\n",
        "        ).block_until_ready()\n",
        "\n",
        "        end = time.perf_counter_ns()\n",
        "        timings_ms.append((end - start) / 1_000_000)\n",
        "\n",
        "    timings_ms = np.asarray(timings_ms)\n",
        "\n",
        "    return {\n",
        "        \"median_ms\": float(np.median(timings_ms)),\n",
        "        \"mean_ms\": float(np.mean(timings_ms)),\n",
        "        \"min_ms\": float(np.min(timings_ms)),\n",
        "        \"p25_ms\": float(np.percentile(timings_ms, 25)),\n",
        "        \"p75_ms\": float(np.percentile(timings_ms, 75)),\n",
        "        \"std_ms\": float(np.std(timings_ms)),\n",
        "        \"all_timings_ms\": timings_ms.tolist()\n",
        "    }"
      ]
    },

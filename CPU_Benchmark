      "source": [
        "## Exercise 9: Nearest Neighbors Prediction Pipeline\n",
        "\n",
        "Extract the closest 5 neighbor indices from your computed distance matrix calculations, map them back to their ground-truth index assignments in `y_train`, and compute the majority class designation to yield your predictions array (`y_pred`)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "metadata": {
        "id": "IX96EuIkaQct"
      },
      "outputs": [],
      "source": [
        "def predict_labels_knn(distance_matrix, y_train, k=5):\n",
        "    # Process array entries to isolate top-k shortest distance paths and execute vote functions\n",
        "    if distance_matrix.ndim != 2:\n",
        "        raise ValueError(\"distance_matrix must be a two-dimensional array\")\n",
        "    if not 1 <= k <= distance_matrix.shape[1]:\n",
        "        raise ValueError(\"k must be between 1 and the number of training samples\")\n",
        "\n",
        "    _, nearest_neighbor_indices = jax.lax.top_k(-distance_matrix, k)\n",
        "    target_device = distance_matrix.device\n",
        "    y_train_jax = jax.device_put(\n",
        "        np.asarray(y_train, dtype=np.int32), device=target_device\n",
        "    )\n",
        "    neighbor_labels = y_train_jax[nearest_neighbor_indices]\n",
        "    churn_votes = jnp.sum(neighbor_labels, axis=1)\n",
        "\n",
        "    return churn_votes * 2 > k\n"
      ]
    },

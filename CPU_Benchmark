      "outputs": [],
      "source": [
        "def allocate_workload_to_hardware(X_train_np, X_test_np, backend_target='cpu'):\n",
        "    \"\"\"\n",
        "    Explicitly captures a target cluster device handle and assigns arrays to memory storage limits.\n",
        "    \"\"\"\n",
        "    # 1. Fetch the target device primitive from your active backend topography\n",
        "    device = jax.devices(backend_target)[0]\n",
        "\n",
        "    # 2. Push inputs to device memory\n",
        "    # Hint: X_train_jax = jax.device_put(your_numpy_array, device=device)\n",
        "    X_train_jax = jax.device_put(\n",
        "        np.asarray(X_train_np, dtype=np.float32), device=device\n",
        "    )\n",
        "    X_test_jax = jax.device_put(\n",
        "        np.asarray(X_test_np, dtype=np.float32), device=device\n",
        "    )\n",
        "\n",
        "    return X_train_jax, X_test_jax\n"
      ]
